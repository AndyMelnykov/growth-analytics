# Copy to .env and edit. .env is gitignored; never commit real credentials.
# docker compose reads .env automatically; Python reads the same names.

# Pinned memgraph-mage image tag (see https://hub.docker.com/r/memgraph/memgraph-mage/tags).
# Never use "latest". Bump deliberately and snapshot before upgrading.
MEMGRAPH_IMAGE_TAG=3.13.1

# Pinned Memgraph Lab tag (used only with `--profile ui`).
LAB_IMAGE_TAG=3.13.2

# Where Python clients connect (compose publishes Bolt on 127.0.0.1 only).
MEMGRAPH_HOST=127.0.0.1
MEMGRAPH_PORT=7687

# Admin account created by Memgraph itself at first start (empty data volume only).
# Changing these later does NOT change an existing volume's user; reset with
# `docker compose down -v` (deletes all graph data) or ALTER the user in Cypher.
MEMGRAPH_USER=admin
# Use letters, digits and _ - . only. docker compose interpolates `$` in .env and
# other characters (quotes, #, spaces) are parsed differently by compose, the
# healthcheck shell and the Python .env loader, which would leave the server and
# the client with different passwords. Nothing enforces this; keep to the set.
MEMGRAPH_PASSWORD=CHANGE_ME_STRONG_PASSWORD
